# Copy this file to .env and fill in real values. Do NOT commit .env.
#   cp .env.example .env

# MySQL (the database container is created with this root password + database name)
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
MYSQL_DATABASE=mydatabase

# JWT signing (backend). Use a long random string for the secret.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=devhub
JWT_AUDIENCE=devhub-users

# Spotify API credentials (backend)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Public origin the app is served from — used for CORS on the API + chat hub.
APP_ORIGIN=https://app.sefzz.com

# Host folder with your Spotify "Extended Streaming History" JSON export.
# Read by the one-off import service:  docker compose run --rm backend-import
SPOTIFY_IMPORT_HOST_DIR=C:\path\to\Spotify Extended Streaming History
